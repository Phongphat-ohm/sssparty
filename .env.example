# ==============================================================================
# SSSParty — Production Environment Variables Configuration
# ==============================================================================

# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# ตัวอย่าง Local / Docker: postgresql://postgres:password@localhost:5432/sssparty?schema=public
# ตัวอย่าง Supabase / Neon: postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:secure_password@localhost:5432/sssparty?schema=public"

# จำนวน Connection สูงสุดใน Connection Pool (Default: 20)
DB_POOL_MAX="20"

# 2. Authentication & Security
# ------------------------------------------------------------------------------
# สตริงสุ่มความยาวอย่างน้อย 32 ตัวอักษรสำหรับลงนาม JWT Token (ห้ามปล่อยว่างในโหมด Production)
# สร้างได้ด้วยคำสั่ง: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-string-with-at-least-32-characters"

# 3. Application Domain & URLs
# ------------------------------------------------------------------------------
# URL หน้าเว็บจริงของระบบ (ใช้สำหรับสร้างลิงก์และ CORS)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# 4. S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# MinIO: http://your-minio-host:9000
# AWS S3: เว้นว่างได้หากใช้ default endpoint ของ region
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="sssparty-submissions"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"

# Public URL ของ Bucket ในกรณีที่ต้องการเปิดให้ดาวน์โหลดตรง (ถ้าไม่มี ให้ปล่อยว่าง ระบบจะดึงผ่าน Proxy API /api/files/* อัตโนมัติ)
S3_PUBLIC_URL=""

# กำหนดเป็น true สำหรับ MinIO หรือ Local S3 Emulator (Default: false)
S3_FORCE_PATH_STYLE="false"

# 5. External Report Template API (Qorstack Report Engine)
# ------------------------------------------------------------------------------
REPORT_API_URL="https://api-reports.ppkxb.space"
REPORT_API_KEY="your_report_api_key_here"